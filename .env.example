# =============================================================================
# ASL Translate — Environment Configuration Template
# =============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# CRITICAL SECURITY DIRECTIVES:
# 1. NEVER commit actual .env files or secret keys to GitHub.
# 2. GEMINI_API_KEY must ONLY exist on the secure backend server.
# 3. NEVER prefix secret keys with VITE_ (VITE_ prefixes expose values in client bundles).
# =============================================================================

# [BACKEND ONLY - REQUIRED]
# Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# Authenticates server-side multimodal vision translation in server.ts.
GEMINI_API_KEY=

# [FRONTEND ONLY - OPTIONAL FOR GITHUB PAGES]
# Base URL for the backend API when frontend is hosted on a separate static domain (e.g., GitHub Pages).
# Leave empty for local development or full-stack deployments where frontend & backend share origin.
# Example: https://asl-translator-api.yourdomain.com
VITE_API_BASE_URL=

# [BACKEND ONLY - OPTIONAL]
# Allowed origin for Cross-Origin Resource Sharing (CORS) when frontend is on GitHub Pages.
# Example: https://your-username.github.io
ALLOWED_ORIGIN=

# [BACKEND ONLY - OPTIONAL]
# Server port (defaults to 3000 in container environments).
PORT=3000

# [BACKEND ONLY - OPTIONAL]
# Hosted application public URL.
APP_URL=

