# GEMINI_API_KEY: Required for Gemini AI API calls.
# MUST ONLY be set on the secure backend server (e.g. Cloud Run, Render, Railway).
# Never expose or commit this key to frontend or client-side code.
GEMINI_API_KEY=

# VITE_API_BASE_URL: Optional for GitHub Pages deployment.
# Points the client-side frontend to your hosted backend API URL.
# Example: https://my-asl-backend.run.app
VITE_API_BASE_URL=

# ALLOWED_ORIGIN: CORS allowlist on the backend server for GitHub Pages frontend.
# Example: https://username.github.io
ALLOWED_ORIGIN=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL=

